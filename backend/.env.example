# Required for AI features
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-5.6-luna

# Supabase project (public anon key is okay on clients; keep service keys server-only)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=replace_me

# RevenueCat server-side secret key for entitlement verification.
# Never place this secret in the Flutter app.
REVENUECAT_SECRET_API_KEY=replace_me
REVENUECAT_ENTITLEMENT_ID=premium

# Local/demo switches. Set both false for production.
ALLOW_DEMO_MODE=true
ALLOW_SIMULATED_PURCHASES=true

# Comma-separated RSS URLs can override the built-in verified public feeds.
# NEWS_RSS_FEEDS=https://example.com/feed.xml,https://example.org/rss
NEWS_REFRESH_HOURS=6
CRON_SECRET=replace_with_a_long_random_value

# Production example: https://yourapp.example
CORS_ORIGIN=*
PORT=5000
